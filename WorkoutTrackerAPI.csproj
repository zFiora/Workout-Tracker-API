<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Precompiles native code at publish time instead of JIT-ing on first request,
         shortening the visible-to-users window during a container restart/cold start.
         Only takes effect when a RuntimeIdentifier is supplied — the Dockerfile passes
         "-r linux-x64" on its `dotnet publish` command for that reason. Deliberately NOT
         hardcoding RuntimeIdentifier/SelfContained here: doing so forces that RID on
         local `dotnet build`/`dotnet run` too, which breaks on a non-linux-x64 dev machine. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder of this one; the SDK's default glob
         would otherwise also compile its files (and its Xunit references) into
         this project, causing duplicate-attribute build errors. -->
    <Compile Remove="WorkoutTrackerAPI.Tests\**" />
    <Content Remove="WorkoutTrackerAPI.Tests\**" />
    <EmbeddedResource Remove="WorkoutTrackerAPI.Tests\**" />
    <None Remove="WorkoutTrackerAPI.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Resend" Version="0.15.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.1" />
  </ItemGroup>

</Project>
